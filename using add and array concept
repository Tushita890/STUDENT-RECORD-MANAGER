import java.io.*;
import java.util.*;

class Student {
    String studentID;
    String name;
    int age;
    String gender;
    int studentClass;
    int math;
    int science;
    int english;
    int history;
    int computer;
    double attendancePercent;
    String extracurricular;
    int total;
    String grade;

    Student(String studentID, String name, int age, String gender, int studentClass,
            int math, int science, int english, int history, int computer,
            double attendancePercent, String extracurricular, int total, String grade) {
        this.studentID = studentID;
        this.name = name;
        this.age = age;
        this.gender = gender;
        this.studentClass = studentClass;
        this.math = math;
        this.science = science;
        this.english = english;
        this.history = history;
        this.computer = computer;
        this.attendancePercent = attendancePercent;
        this.extracurricular = extracurricular;
        this.total = total;
        this.grade = grade;
    }

    // Creates a new student and calculates Total and Grade.
    Student(String studentID, String name, int age, String gender, int studentClass,
            int math, int science, int english, int history, int computer,
            double attendancePercent, String extracurricular) {
        this(studentID, name, age, gender, studentClass, math, science, english,
             history, computer, attendancePercent, extracurricular,
             math + science + english + history + computer,
             calculateGrade(math + science + english + history + computer));
    }

    static String calculateGrade(int total) {
        double percentage = total / 5.0;

        if (percentage >= 80) return "A";
        if (percentage >= 60) return "B";
        if (percentage >= 40) return "C";
        if (percentage >= 30) return "D";
        return "F";
    }

    String toCSV() {
        return studentID + "," + name + "," + age + "," + gender + "," +
               studentClass + "," + math + "," + science + "," + english + "," +
               history + "," + computer + "," + attendancePercent + "," +
               extracurricular + "," + total + "," + grade;
    }

    void display() {
        System.out.printf("%-8s %-22s %-4d %-8s %-6d %-6d %-6d %-7d %-7d %-8d %-9.2f %-15s %-6d %-5s%n",
                studentID, name, age, gender, studentClass, math, science,
                english, history, computer, attendancePercent,
                extracurricular, total, grade);
    }
}

public class StudentsRecordManager {

    // DSA concept: Array
    static Student[] students = new Student[20000];
    static int count = 0;

    static final String CSV_FILE = "student_records.csv";

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        loadFromCSV();

        System.out.println("\n==============================================");
        System.out.println("       STUDENT RECORD MANAGER - DSA");
        System.out.println("==============================================");
        System.out.println("Records loaded: " + count);

        while (true) {
            System.out.println("\n----------- MENU -----------");
            System.out.println("1. Display all students");
            System.out.println("2. Add student record");
            System.out.println("3. Search student by ID");
            System.out.println("4. Save records to CSV");
            System.out.println("5. Exit");
            System.out.print("Enter your choice: ");

            String choice = sc.nextLine();

            switch (choice) {
                case "1":
                    displayAll();
                    break;
                case "2":
                    addStudent(sc);
                    break;
                case "3":
                    searchStudent(sc);
                    break;
                case "4":
                    saveToCSV();
                    break;
                case "5":
                    saveToCSV();
                    System.out.println("Program closed successfully.");
                    sc.close();
                    return;
                default:
                    System.out.println("Invalid choice. Please try again.");
            }
        }
    }

    static void loadFromCSV() {
        File file = new File(CSV_FILE);

        if (!file.exists()) {
            System.out.println("CSV file not found: " + CSV_FILE);
            System.out.println("Place student_records.csv in the same folder as the Java file.");
            return;
        }

        try (BufferedReader br = new BufferedReader(new FileReader(file))) {
            String line = br.readLine(); // Skip header

            while ((line = br.readLine()) != null && count < students.length) {
                if (line.trim().isEmpty()) continue;

                String[] data = line.split(",", -1);

                if (data.length < 14) {
                    System.out.println("Skipped invalid row: " + line);
                    continue;
                }

                String extracurricular = data[11].trim();
                if (extracurricular.isEmpty()) extracurricular = "None";

                try {
                    students[count++] = new Student(
                            data[0].trim(),
                            data[1].trim(),
                            Integer.parseInt(data[2].trim()),
                            data[3].trim(),
                            Integer.parseInt(data[4].trim()),
                            Integer.parseInt(data[5].trim()),
                            Integer.parseInt(data[6].trim()),
                            Integer.parseInt(data[7].trim()),
                            Integer.parseInt(data[8].trim()),
                            Integer.parseInt(data[9].trim()),
                            Double.parseDouble(data[10].trim()),
                            extracurricular,
                            Integer.parseInt(data[12].trim()),
                            data[13].trim()
                    );
                } catch (NumberFormatException e) {
                    System.out.println("Skipped invalid numeric row: " + line);
                }
            }

            System.out.println("CSV data loaded successfully.");

        } catch (IOException e) {
            System.out.println("Error reading CSV: " + e.getMessage());
        }
    }

    static void displayAll() {
        if (count == 0) {
            System.out.println("No student records available.");
            return;
        }

        System.out.println("\nTotal records: " + count);
        System.out.printf("%-8s %-22s %-4s %-8s %-6s %-6s %-6s %-7s %-7s %-8s %-9s %-15s %-6s %-5s%n",
                "ID", "Name", "Age", "Gender", "Class", "Math", "Science",
                "English", "History", "Computer", "Attendance", "Activity", "Total", "Grade");

        System.out.println("---------------------------------------------------------------------------------------------------------------");

        for (int i = 0; i < count; i++) {
            students[i].display();
        }
    }

    static void addStudent(Scanner sc) {
        if (count >= students.length) {
            System.out.println("Array is full. Cannot add more students.");
            return;
        }

        String studentID = generateStudentID();

        System.out.println("\nEnter new student details:");

        System.out.print("Name: ");
        String name = sc.nextLine();

        System.out.print("Age: ");
        int age = readInt(sc);

        System.out.print("Gender: ");
        String gender = sc.nextLine();

        System.out.print("Class: ");
        int studentClass = readInt(sc);

        System.out.print("Math marks: ");
        int math = readMark(sc);

        System.out.print("Science marks: ");
        int science = readMark(sc);

        System.out.print("English marks: ");
        int english = readMark(sc);

        System.out.print("History marks: ");
        int history = readMark(sc);

        System.out.print("Computer marks: ");
        int computer = readMark(sc);

        System.out.print("Attendance percentage: ");
        double attendance = readAttendance(sc);

        System.out.print("Extracurricular activity (enter None if not applicable): ");
        String activity = sc.nextLine();
        if (activity.trim().isEmpty()) activity = "None";

        students[count++] = new Student(
                studentID, name, age, gender, studentClass,
                math, science, english, history, computer,
                attendance, activity
        );

        Student added = students[count - 1];

        System.out.println("\nStudent added successfully!");
        System.out.println("Generated Student ID: " + added.studentID);
        System.out.println("Total marks: " + added.total);
        System.out.println("Grade: " + added.grade);

        // Save immediately so the new record is also stored in the CSV file.
        saveToCSV();
    }

    static void searchStudent(Scanner sc) {
        System.out.print("Enter Student ID: ");
        String id = sc.nextLine().trim();

        for (int i = 0; i < count; i++) {
            if (students[i].studentID.equalsIgnoreCase(id)) {
                System.out.println("\nStudent found at array index: " + i);
                System.out.printf("%-8s %-22s %-4s %-8s %-6s %-6s %-6s %-7s %-7s %-8s %-9s %-15s %-6s %-5s%n",
                        "ID", "Name", "Age", "Gender", "Class", "Math", "Science",
                        "English", "History", "Computer", "Attendance", "Activity", "Total", "Grade");
                students[i].display();
                return;
            }
        }

        System.out.println("Student record not found.");
    }

    static void saveToCSV() {
        try (PrintWriter pw = new PrintWriter(new FileWriter(CSV_FILE))) {

            pw.println("StudentID,Name,Age,Gender,Class,Math,Science,English,History,Computer,AttendancePercent,Extracurricular,Total,Grade");

            for (int i = 0; i < count; i++) {
                pw.println(students[i].toCSV());
            }

            System.out.println("Records saved successfully to " + CSV_FILE);

        } catch (IOException e) {
            System.out.println("Error saving CSV: " + e.getMessage());
        }
    }

    static String generateStudentID() {
        int maxID = 9999;

        for (int i = 0; i < count; i++) {
            String id = students[i].studentID;
            if (id.startsWith("S")) {
                try {
                    int number = Integer.parseInt(id.substring(1));
                    if (number > maxID) {
                        maxID = number;
                    }
                } catch (NumberFormatException ignored) {
                }
            }
        }

        return "S" + (maxID + 1);
    }

    static int readInt(Scanner sc) {
        while (true) {
            try {
                return Integer.parseInt(sc.nextLine().trim());
            } catch (NumberFormatException e) {
                System.out.print("Enter a valid integer: ");
            }
        }
    }

    static int readMark(Scanner sc) {
        while (true) {
            int mark = readInt(sc);
            if (mark >= 0 && mark <= 100) return mark;
            System.out.print("Marks must be between 0 and 100. Enter again: ");
        }
    }

    static double readAttendance(Scanner sc) {
        while (true) {
            try {
                double value = Double.parseDouble(sc.nextLine().trim());
                if (value >= 0 && value <= 100) return value;
            } catch (NumberFormatException ignored) {
            }
            System.out.print("Attendance must be between 0 and 100. Enter again: ");
        }
    }
}
