import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

class Student {
    String studentId;
    String name;
    int age;
    String gender;
    int gradeClass;
    int math;
    int science;
    int english;
    int history;
    int computer;
    double attendancePercent;
    String extracurricular;
    int total;
    String grade;

    public Student(String[] data) {
        this.studentId = data[0];
        this.name = data[1];
        this.age = Integer.parseInt(data[2]);
        this.gender = data[3];
        this.gradeClass = Integer.parseInt(data[4]);
        this.math = Integer.parseInt(data[5]);
        this.science = Integer.parseInt(data[6]);
        this.english = Integer.parseInt(data[7]);
        this.history = Integer.parseInt(data[8]);
        this.computer = Integer.parseInt(data[9]);
        this.attendancePercent = Double.parseDouble(data[10]);
        this.extracurricular = data[11].isEmpty() ? "None" : data[11];
        this.total = Integer.parseInt(data[12]);
        this.grade = data[13];
    }

    @Override
    public String toString() {
        return String.format(
            "ID: %s | Name: %s | Class: %d | Total: %d | Grade: %s | Attendance: %.2f%% | Extra: %s",
            studentId, name, gradeClass, total, grade, attendancePercent, extracurricular
        );
    }
}

public class StudentSearch {

    public static List<Student> loadCSV(String filePath) {
        List<Student> students = new ArrayList<>();
        
        try (BufferedReader br = new BufferedReader(new FileReader(filePath))) {
            String line = br.readLine(); // Skip CSV Header
            
            while ((line = br.readLine()) != null) {
                // Split by comma while preserving empty trailing fields
                String[] values = line.split(",", -1);
                if (values.length >= 14) {
                    students.add(new Student(values));
                }
            }
        } catch (IOException e) {
            System.err.println("Error reading file: " + e.getMessage());
        }
        
        return students;
    }

    public static void main(String[] args) {
        String csvFile = "student_records.csv";
        List<Student> students = loadCSV(csvFile);

        System.out.println("Loaded " + students.size() + " student records.");
        Scanner scanner = new Scanner(System.in);

        while (true) {
            System.out.print("\nEnter Student ID or Name to search (or 'exit' to quit): ");
            String query = scanner.nextLine().trim();

            if (query.equalsIgnoreCase("exit")) {
                break;
            }

            boolean found = false;
            for (Student student : students) {
                if (student.studentId.equalsIgnoreCase(query) || 
                    student.name.toLowerCase().contains(query.toLowerCase())) {
                    System.out.println("Match found: " + student);
                    found = true;
                }
            }

            if (!found) {
                System.out.println("No matching records found for: " + query);
            }
        }

        scanner.close();
    }
}
